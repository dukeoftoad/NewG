<!--
  toadGALLERY launcher foreground — "the Photo IS the Toad" (toad family
  identity). Continues the think-different family signature (toadFILES fuses
  the toad with a folder, toadCALCULATOR IS the calculator-toad): here a photo
  print doubles as the toad face — two bulging eye bumps on top, the wide
  family smile, and a filmstrip of three thumbnail keys that double as toad
  spots, with front feet peeking underneath. A second print behind the head
  (rotated -7°) makes the stack read as a gallery, and the single white
  sparkle — the family one-accent rule — stands for Magic Search.
  Eye bumps share the body green (one silhouette + ink features, the family
  language) so the same drawable stays legible on the brand-green launcher
  background AND on the cream splash background.
  Hand-authored geometry on the 108dp adaptive canvas; every extreme point is
  ≤ 29.3dp from the center (54,54) — inside the 66dp adaptive safe zone.
  Ink #1B2A13, belly green #A9D48C and toad-body green #4C7A3F are the
  toadFILES / toadCALCULATOR family tones; launcher background #3E6B1E is the
  family brand green.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Back print of the gallery stack, rotated so its corners peek out. -->
    <group
        android:rotation="-7"
        android:pivotX="54"
        android:pivotY="54">
        <path
            android:fillColor="#4C7A3F"
            android:pathData="M30,38 h48 a6,6 0 0 1 6,6 v18 a6,6 0 0 1 -6,6 h-48 a6,6 0 0 1 -6,-6 v-18 a6,6 0 0 1 6,-6 z" />
    </group>

    <!-- Front feet peeking under the photo — creature, not appliance. -->
    <path
        android:fillColor="#A9D48C"
        android:pathData="M42.5,76 m-6.5,0 a6.5,2.4 0 1,0 13,0 a6.5,2.4 0 1,0 -13,0 M65.5,76 m-6.5,0 a6.5,2.4 0 1,0 13,0 a6.5,2.4 0 1,0 -13,0" />

    <!-- Photo print = toad face. -->
    <path
        android:fillColor="#A9D48C"
        android:pathData="M30,44 h48 a7,7 0 0 1 7,7 v16 a7,7 0 0 1 -7,7 h-48 a7,7 0 0 1 -7,-7 v-16 a7,7 0 0 1 7,-7 z" />

    <!-- Eye bumps, merged into the head silhouette. -->
    <path
        android:fillColor="#A9D48C"
        android:pathData="M45,40.5 m-7.5,0 a7.5,7.5 0 1,0 15,0 a7.5,7.5 0 1,0 -15,0 M63,40.5 m-7.5,0 a7.5,7.5 0 1,0 15,0 a7.5,7.5 0 1,0 -15,0" />

    <!-- Pupils, shifted down-inward: the toad is looking at your photos. -->
    <path
        android:fillColor="#1B2A13"
        android:pathData="M46.8,42.3 m-3,0 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0 M61.2,42.3 m-3,0 a3,3 0 1,0 -6,0" />

    <!-- The wide family smile. -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#1B2A13"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:pathData="M41.5,60.5 Q54,66.5 66.5,60.5" />

    <!-- Filmstrip of three thumbnail keys — keys that double as toad spots. -->
    <path
        android:fillColor="#4C7A3F"
        android:pathData="M40.3,67 h6.4 a1.6,1.6 0 0 1 1.6,1.6 v1.8 a1.6,1.6 0 0 1 -1.6,1.6 h-6.4 a1.6,1.6 0 0 1 -1.6,-1.6 v-1.8 a1.6,1.6 0 0 1 1.6,-1.6 z
            M50.8,67 h6.4 a1.6,1.6 0 0 1 1.6,1.6 v1.8 a1.6,1.6 0 0 1 -1.6,1.6 h-6.4 a1.6,1.6 0 0 1 -1.6,-1.6 v-1.8 a1.6,1.6 0 0 1 1.6,-1.6 z
            M61.3,67 h6.4 a1.6,1.6 0 0 1 1.6,1.6 v1.8 a1.6,1.6 0 0 1 -1.6,1.6 h-6.4 a1.6,1.6 0 0 1 -1.6,-1.6 v-1.8 a1.6,1.6 0 0 1 1.6,-1.6 z" />

    <!-- The single white accent: a Magic Search sparkle on the photo. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M73,45.6 C73.45,48.1 74.4,49.05 76.9,49.5 C74.4,49.95 73.45,50.9 73,53.4 C72.55,50.9 71.6,49.95 69.1,49.5 C71.6,49.05 72.55,48.1 73,45.6 Z" />
</vector>
